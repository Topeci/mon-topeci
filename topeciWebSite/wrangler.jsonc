{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mon-topeci",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Référence à lui-même, le nom doit être celui du worker
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mon-topeci"
		}
	],
	"images": {
		// Optimisation des images (next/image) par Cloudflare
		"binding": "IMAGES"
	},
	// Garde les variables saisies dans le tableau de bord Cloudflare à chaque mise en ligne
	"keep_vars": true,
	"observability": {
		"enabled": true
	}
}
